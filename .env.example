# Example environment variables for intelliform
# Copy this file to `.env` and fill values before running locally.
# IMPORTANT: Do NOT commit your `.env` file to source control. `.env` is already ignored by `.gitignore`.

# App runtime
NODE_ENV=development
FRONTEND_PORT=9090
SERVER_PORT=3000

# CORS / frontend hosts (comma-separated). In production, set to your frontend origin(s).
# Example: FRONTEND_HOSTS=https://app.example.com
FRONTEND_HOSTS=https://ihvn.duckdns.org
ALLOW_ALL_ORIGINS=false

# Allow public admin-like endpoints in dev (true/false)
ALLOW_PUBLIC_ADMIN=false

# Debug flags (development only)
VITE_CANVAS_DEBUG=false

# Database (Postgres)
DB_USER=postgres
DB_PASSWORD=changeme
DB_HOST=localhost
DB_NAME=dqappdb
DB_PORT=5432

# Database table prefix - ALL tables will be created with this prefix
# Development: 'dqai_' (default)
# Production/Multi-tenant: 'dqatb_' (recommended)
# On first run, app creates only prefixed tables (e.g., dqatb_users, dqatb_activities)
# Changing this is a one-time operation - migrations handle consolidation
TABLE_PREFIX=dqatb_

# External API keys
TINYMCE_API_KEY=YOUR_TINYMCE_API_KEY_HERE

# Optional: override for frontend when behind proxies or different host
FRONTEND_HOST=https://ihvn.duckdns.org
 
# Client (Vite) runtime overrides - used by frontend code
# If set, these will be available as `import.meta.env.VITE_API_URL` and `import.meta.env.VITE_AUTH_URL`.
# Example for proxying through the frontend dev server: VITE_API_URL=/api
VITE_API_URL=/api
VITE_AUTH_URL=/auth
# Comma-separated hosts allowed to access Vite dev server
VITE_ALLOWED_HOSTS=localhost,127.0.0.1,ihvn.duckdns.org
# Set true when accessing Vite dev server through HTTPS reverse proxy (Caddy/Nginx)
VITE_USE_HTTPS_PROXY=true
# Public host used by HMR when VITE_USE_HTTPS_PROXY=true
VITE_PUBLIC_HOST=ihvn.duckdns.org

# Microsoft Entra / Power BI Quick Create (User Owns Data)
# Register a public/SPA application and add the frontend URL as an allowed redirect URI.
VITE_POWERBI_CLIENT_ID=aec914da-4c6a-4fc0-8b2f-3a63a9665813
VITE_POWERBI_TENANT_ID=995c8049-bfb4-4df7-a971-0330afa808c9
VITE_POWERBI_REDIRECT_URI=https://ihvn.duckdns.org
